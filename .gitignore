models/

# Stray run output at repo root; results belong in results/<runID>/
/results*.json

# NOTE: results/<runID>/raw/*.jsonl.gz is deliberately NOT ignored — CLAUDE.md
# allows committing compressed generations under 50MB. Anything larger stays on
# the pod, with sha256 + regeneration command recorded in the manifest.
